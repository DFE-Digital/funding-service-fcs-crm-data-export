{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name"
		},
		"link_targetdatabase": {
			"type": "string"
		},
		"link_sourcedatabseREST": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/delete-sync-pipeline_publish')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "generate-entylist-entyconfiguration",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "get access token",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('link_targetdatabase')]",
							"type": "LinkedServiceReference",
							"parameters": {
								"LS_DomainName": {
									"value": "@pipeline().globalParameters.DomainName",
									"type": "Expression"
								},
								"LS_DatabaseName": {
									"value": "@pipeline().globalParameters.DatabaseName",
									"type": "Expression"
								}
							}
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "SELECT EntityName,\r\nEntitySetName,\r\nPrimaryIdAttribute,\r\nDeltaMarkerAttribute,\r\n\r\nSourcetEntityId,\r\nDeltaMarker,\r\nIsDeltaLoad\r\n\r\nfrom [dbo].[EntityMetadata] \r\nwhere  EntityName='audit'"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "generate token",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"url": {
								"value": "@pipeline().globalParameters.TokenURL",
								"type": "Expression"
							},
							"method": "POST",
							"headers": {
								"Content-Type": "application/x-www-form-urlencoded"
							},
							"body": {
								"value": "@concat('grant_type=client_credentials&client_id=',pipeline().globalParameters.TokenBodyClientID,'&client_secret=',pipeline().globalParameters.TokenBodyClientSecret,'&resource=',pipeline().globalParameters.TokenBodyResource)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "get access token",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "generate token",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"variableName": "crm_token",
							"value": {
								"value": "@activity('generate token').output.access_token",
								"type": "Expression"
							}
						}
					},
					{
						"name": "ACT_failed_TokenGenrate_Audit",
						"description": "save audit log status in ADFPipelineAudit table  ",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "generate token",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Save_Audit_Log",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Pipeline": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								},
								"ActivityName": "Failed Token Generation",
								"ActivityOutput": {
									"value": "@activity('generate token').error.message",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "ACT_generate-entylist-entyconfiguration_Failed_Audit",
						"description": "Log Sql Entity configuration  Failed Audit",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "generate-entylist-entyconfiguration",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Save_Audit_Log",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Pipeline": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								},
								"ActivityName": "Copy REST SQL EntityMetadata Failed Audit",
								"ActivityOutput": {
									"value": "@activity('generate-entylist-entyconfiguration').error.message",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Set isError_Token_failed",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "generate token",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"variableName": "isError",
							"value": true
						}
					},
					{
						"name": "Set isError_Gen_EntityList_Config",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "generate-entylist-entyconfiguration",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"variableName": "isError",
							"value": true
						}
					},
					{
						"name": "upd delta marker-entitymetadata-tbl",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Insert last run ts-CRMDataExportSyncHistory_tbl",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('link_targetdatabase')]",
							"type": "LinkedServiceReference",
							"parameters": {
								"LS_DomainName": {
									"value": "@pipeline().globalParameters.DomainName",
									"type": "Expression"
								},
								"LS_DatabaseName": {
									"value": "@pipeline().globalParameters.DatabaseName",
									"type": "Expression"
								}
							}
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "update dbo.EntityMetadata set DeltaMarker =(\nselect top(1) convert(varchar(51), coalesce(createdon,'1900-01-01 01:01:01'), 127) + 'Z' from audit order by createdon desc\n)\nwhere EntityName = 'audit';",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "ACT_update_delta marker_entity_failed_log_copy1",
						"description": "Update delta marker entity failed log in ADFPipelineAudit table  ",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "upd delta marker-entitymetadata-tbl",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Save_Audit_Log",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Pipeline": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								},
								"TableName": {
									"value": "audit",
									"type": "Expression"
								},
								"ActivityName": "upd delta marker-entitymetadata-tbl",
								"ActivityOutput": {
									"value": "@string(activity('upd delta marker-entitymetadata-tbl').error)",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Set isError_UpdateDeltaMarker",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "upd delta marker-entitymetadata-tbl",
								"dependencyConditions": [
									"Failed"
								]
							},
							{
								"activity": "Delete Sync Stored Procedure",
								"dependencyConditions": [
									"Failed"
								]
							},
							{
								"activity": "Insert last run ts-CRMDataExportSyncHistory_tbl",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"variableName": "isError",
							"value": true
						}
					},
					{
						"name": "Insert last run ts-CRMDataExportSyncHistory_tbl",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "ForEachAuditTable",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('link_targetdatabase')]",
							"type": "LinkedServiceReference",
							"parameters": {
								"LS_DomainName": {
									"value": "@pipeline().globalParameters.DomainName",
									"type": "Expression"
								},
								"LS_DatabaseName": {
									"value": "@pipeline().globalParameters.DatabaseName",
									"type": "Expression"
								}
							}
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "INSERT INTO [dbo].[CRMDataExportSyncHistory]\n           (\n            [DeltaMarker]\n           ,[LastRunOn]\n           ,[Status]\n           ,[EntityName]\n           ,[SourcetEntityId])\n     VALUES\n           (\n            convert(varchar(51), coalesce(CURRENT_TIMESTAMP,'1900-01-01 01:01:01'), 127) + 'Z'\n           ,convert(varchar(51), coalesce(CURRENT_TIMESTAMP,'1900-01-01 01:01:01'), 127) + 'Z'\n           ,1\n          ,'audit'\n           ,(select SourcetEntityId from EntityMetadata where EntityName='audit')\n           )",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Insert last fail ts-CRMDataExportSyncHistory_tbl",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "ForEachAuditTable",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('link_targetdatabase')]",
							"type": "LinkedServiceReference",
							"parameters": {
								"LS_DomainName": {
									"value": "@pipeline().globalParameters.DomainName",
									"type": "Expression"
								},
								"LS_DatabaseName": {
									"value": "@pipeline().globalParameters.DatabaseName",
									"type": "Expression"
								}
							}
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "INSERT INTO [dbo].[CRMDataExportSyncHistory]\n           (\n            [DeltaMarker]\n           ,[LastRunOn]\n           ,[Status]\n           ,[EntityName]\n           ,[SourcetEntityId])\n     VALUES\n           (\n            convert(varchar(51), coalesce(CURRENT_TIMESTAMP,'1900-01-01 01:01:01'), 127) + 'Z'\n           ,convert(varchar(51), coalesce(CURRENT_TIMESTAMP,'1900-01-01 01:01:01'), 127) + 'Z'\n           ,0\n          ,'audit'\n           ,(select SourcetEntityId from EntityMetadata where EntityName='audit')\n           )\n\n\n           ",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Set isError_CopyActivity",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Insert last fail ts-CRMDataExportSyncHistory_tbl",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"variableName": "isError",
							"value": true
						}
					},
					{
						"name": "ACT_Insert_CRMDataExportSyncHistory_failed_log_copy1",
						"description": "insert activity for CRMDataExportSyncHistory table failed log  status in ADFPipelineAudit table  ",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "Insert last run ts-CRMDataExportSyncHistory_tbl",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Save_Audit_Log",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Pipeline": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								},
								"TableName": {
									"value": "audit",
									"type": "Expression"
								},
								"ActivityName": "Insert last run ts-CRMDataExportSyncHistory_tbl",
								"ActivityOutput": {
									"value": "@string(activity('Insert last run ts-CRMDataExportSyncHistory_tbl').error)",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Delete Sync Stored Procedure",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "upd delta marker-entitymetadata-tbl",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[GetDeleteRecordGuidsFromAuditAndDeleteTheRecordsFromRespectiveTables]"
						},
						"linkedServiceName": {
							"referenceName": "[parameters('link_targetdatabase')]",
							"type": "LinkedServiceReference",
							"parameters": {
								"LS_DomainName": {
									"value": "@pipeline().globalParameters.DomainName",
									"type": "Expression"
								},
								"LS_DatabaseName": {
									"value": "@pipeline().globalParameters.DatabaseName",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "If Condition1",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Wait2",
								"dependencyConditions": [
									"Skipped"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@variables('isError')",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "Post Slack Message_Success",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"url": "",
										"method": "POST",
										"body": {
											"value": "{\"text\":\"Pipeline *@{pipeline().Pipeline}* Is succeeded\"}",
											"type": "Expression"
										}
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "Post Slack Message_Fail",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"url": "",
										"method": "POST",
										"body": {
											"value": "{\"text\":\"Pipeline *@{pipeline().Pipeline}* Is Failed\"}",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "Set DeltaMarker",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "generate-entylist-entyconfiguration",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"variableName": "DeltaMarkerAudit",
							"value": {
								"value": "@activity('generate-entylist-entyconfiguration').output.resultsets[0]['rows'][0]['DeltaMarker']",
								"type": "Expression"
							}
						}
					},
					{
						"name": "ACT_InsertLastFailed_CRMDataExportSyncHistory_Log",
						"description": "insert activity for CRMDataExportSyncHistory table failed log  status in ADFPipelineAudit table  ",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "Insert last fail ts-CRMDataExportSyncHistory_tbl",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Save_Audit_Log",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Pipeline": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								},
								"TableName": {
									"value": "audit",
									"type": "Expression"
								},
								"ActivityName": "Insert last run ts-CRMDataExportSyncHistory_tbl",
								"ActivityOutput": {
									"value": "@string(activity('Insert last fail ts-CRMDataExportSyncHistory_tbl').error)\n\n",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "ACTUpdate_DeletePipeline_Status",
						"description": "Update Delete Pipeline Status  status in ADFPipelineAudit table  ",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "If Condition1",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_Save_Audit_Log",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"Pipeline": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								},
								"TableName": {
									"value": "Audit",
									"type": "Expression"
								},
								"ActivityName": "Delete Sync pipeline Completed",
								"ActivityOutput": {
									"value": "@if(variables('isError'),'Fail' , 'Sucess')",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Wait2",
						"type": "Wait",
						"dependsOn": [
							{
								"activity": "Delete Sync Stored Procedure",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set isError_UpdateDeltaMarker",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set isError_CopyActivity",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"waitTimeInSeconds": 1
						}
					},
					{
						"name": "ForEachAuditTable",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Set DeltaMarker",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@variables('AuditTables')",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "cpy-crmapi-getdata-sql",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"additionalHeaders": {
												"Authorization": {
													"value": "@concat('Bearer ',variables('crm_token'))",
													"type": "Expression"
												},
												"Prefer": "odata.maxpagesize=500"
											},
											"paginationRules": {
												"AbsoluteUrl": "$['@odata.nextLink']"
											}
										},
										"sink": {
											"type": "AzureSqlSink",
											"writeBehavior": "upsert",
											"upsertSettings": {
												"useTempDB": true,
												"keys": [
													"auditid"
												]
											},
											"sqlWriterUseTableLock": false,
											"disableMetricsCollection": false
										},
										"enableStaging": false,
										"validateDataConsistency": true,
										"translator": {
											"type": "TabularTranslator",
											"mappings": [
												{
													"source": {
														"path": "$['value'][0]['objecttypecode']"
													},
													"sink": {
														"name": "objecttypecode",
														"type": "String"
													}
												},
												{
													"source": {
														"path": "$['value'][0]['_objectid_value']"
													},
													"sink": {
														"name": "_objectid_value",
														"type": "String"
													}
												},
												{
													"source": {
														"path": "$['value'][0]['action']"
