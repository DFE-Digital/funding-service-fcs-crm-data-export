				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/x-www-form-urlencoded"
					},
					"url": {
						"value": "@pipeline().globalParameters.TokenURL",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('grant_type=client_credentials&client_id=',pipeline().globalParameters.TokenBodyClientID,'&client_secret=',pipeline().globalParameters.TokenBodyClientSecret,'&resource=',pipeline().globalParameters.TokenBodyResource)",
						"type": "Expression"
