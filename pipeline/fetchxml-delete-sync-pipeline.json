			{
				"name": "upd delta marker-entitymetadata-tbl",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Delete Sync Stored Procedure",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "link_targetdatabase",
					"type": "LinkedServiceReference",
					"parameters": {
						"LS_DomainName": {
							"value": "@pipeline().globalParameters.DomainName",
							"type": "Expression"
						},
						"LS_DatabaseName": {
							"value": "@pipeline().globalParameters.DatabaseName",
							"type": "Expression"
						}
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update dbo.EntityMetadata set DeltaMarker =(\nselect top(1) convert(varchar(51), coalesce(createdon,'1900-01-01 01:01:01'), 127) + 'Z' from audit order by createdon desc\n)\nwhere EntityName = 'audit';",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
