					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "link_targetdatabase",
					"type": "LinkedServiceReference",
					"parameters": {
						"LS_DomainName": {
							"value": "@pipeline().globalParameters.DomainName",
							"type": "Expression"
						},
						"LS_DatabaseName": {
							"value": "@pipeline().globalParameters.DatabaseName",
							"type": "Expression"
						}
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "INSERT INTO [dbo].[CRMDataExportSyncHistory]\n           (\n            [DeltaMarker]\n           ,[LastRunOn]\n           ,[Status]\n           ,[EntityName]\n           ,[SourcetEntityId])\n     VALUES\n           (\n            convert(varchar(51), coalesce(CURRENT_TIMESTAMP,'1900-01-01 01:01:01'), 127) + 'Z'\n           ,convert(varchar(51), coalesce(CURRENT_TIMESTAMP,'1900-01-01 01:01:01'), 127) + 'Z'\n           ,1\n          ,'audit'\n           ,(select SourcetEntityId from EntityMetadata where EntityName='audit')\n           )",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
