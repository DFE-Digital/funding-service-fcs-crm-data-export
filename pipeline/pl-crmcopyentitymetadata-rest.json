			{
				"name": "scr-sql-update-mapping",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "FrEch-Entitydefinition",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
