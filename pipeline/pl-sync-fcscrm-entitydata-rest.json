			{
				"name": "generate-entylist-entyconfiguration",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "get access token",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "link_targetdatabase",
					"type": "LinkedServiceReference",
					"parameters": {
						"LS_DomainName": {
							"value": "@pipeline().globalParameters.DomainName",
							"type": "Expression"
						},
						"LS_DatabaseName": {
							"value": "@pipeline().globalParameters.DatabaseName",
							"type": "Expression"
						}
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "with cte AS(\r\nSELECT a.EntityName,\r\nb.EntitySetName,\r\nCASE WHEN a.AttributeTypeName in ('LookupType','CustomerType','OwnerType') THEN CONCAT('_',AttributeName,'_value') ELSE a.AttributeName END as AttributeName,\r\nb.PrimaryIdAttribute,\r\na.Mapping,\r\na.AttributeTypeName,\r\na.AdditionalcolumnsMapping,\r\nb.DeltaMarkerAttribute,\r\nFORMAT(CAST(b.DeltaMarker AS DATETIME2), 'yyyy-MM-ddTHH:mm:ss') + 'Z' AS DeltaMarker,\r\nb.IsDeltaLoad,\r\nb.SourcetEntityId\r\nfrom [dbo].[CRMEntityAttributeMetadata] a with (nolock) join [dbo].[EntityMetadata] b with (nolock) on a.EntityName = b.EntityName\r\nwhere ((a.AttributeTypeName not in ('VirtualType','PartyListType','ImageType','EntityNameType') and a.IsValidForAdvancedFind=1) or a.IsPrimaryId=1)\r\nand a.EntityName in \r\n(\r\n\t'sfa_contract',\r\n\t'sfa_unitofprocurement',\r\n\t'account',\r\n\t'sfa_contractallocation',\r\n\t'sfa_status',\r\n\t'sfa_subnominalaggregation',\r\n\t'sfa_contractdeliverable',\r\n\t'sfa_fundingstreamperiod',\r\n\t'sfa_contractdeliverableperiod',\r\n\t'sfa_fundingtype',\r\n\t'sfa_fundingstreamperioddeliverable',\r\n\t'sfa_contracttransitionhistory',\r\n\t'sfa_Agency',\r\n\t'sfa_FundingClaimReconciliation'\r\n) \r\nand a.InUse=1 and b.InUse=1\r\n)\r\n\r\nSELECT EntityName,EntitySetName,PrimaryIdAttribute,DeltaMarkerAttribute,SourcetEntityId,\r\ncase when DeltaMarker is null then convert(varchar(51), DATEADD(HOUR, 0, CONVERT(DATETIME, CONVERT(DATE, GETDATE()-15))), 127) + 'Z' else  DeltaMarker end as DeltaMarker,                                         /*'2022-10-31T20:00:00Z'*/\r\nIsDeltaLoad,'Id' as UpsertKey,\r\nSTRING_AGG(CONVERT(nvarchar(max),AttributeName),',') as Query,\r\n'{\"type\":\"TabularTranslator\",\"mappings\":['+'{\"source\":{\"path\":\"['''+PrimaryIdAttribute+''']\"},\"sink\":{\"name\":\"Id\",\"type\":\"Guid\"}},' + STRING_AGG(CONVERT(nvarchar(max),Mapping),',')+'],\"collectionReference\":\"$[''value'']\",\"mapComplexValuesToString\":true}' as Mapping,\r\n'['+ STRING_AGG(CONVERT(nvarchar(max),AdditionalcolumnsMapping),',')+']' as AdditionalColumnMapping\r\nfrom cte where Mapping!=''\r\ngroup by EntityName,EntitySetName,PrimaryIdAttribute,DeltaMarkerAttribute,DeltaMarker,IsDeltaLoad,SourcetEntityId\r\n"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
